# Переменные окружения контейнера n8n. Скопируйте в .env (он в .gitignore) и заполните.
# Токен бота MAX и доступ к PostgreSQL сюда не входят: это учетные данные n8n (PostgreSQL и Header Auth с токеном бота).

# Разрешить узлам Code читать переменные окружения ($env): в n8n 2.x по умолчанию запрещено.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Секрет вебхука MAX: тот же, что передается в поле secret при подписке бота на вебхук; 5–256 символов A-Z a-z 0-9 _ -.
DEMO_MAX_WEBHOOK_SECRET=

# Ключ проверки подписи мини-приложения: 64 hex-символа = HMAC-SHA256 с ключом "WebAppData" от токена бота, например:
# node -e "console.log(require('crypto').createHmac('sha256','WebAppData').update(process.argv[1]).digest('hex'))" <токен бота>
DEMO_WEBAPP_KEY=
